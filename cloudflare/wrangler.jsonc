// Cloudflare Containers deployment of the traceaudit service (API + viewer in one container).
// Deploy: cd cloudflare && npm install && npx wrangler deploy  (Docker must be running: wrangler builds ../Dockerfile)
// Secrets: npx wrangler secret put ANTHROPIC_API_KEY
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "traceaudit",
  "main": "worker.js",
  "compatibility_date": "2026-06-01",
  "containers": [
    {
      "class_name": "TraceauditContainer",
      "image": "../Dockerfile",
      "max_instances": 1,
      "instance_type": "basic"
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "TRACEAUDIT", "class_name": "TraceauditContainer" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TraceauditContainer"] }],
  "vars": {
    "TRACEAUDIT_OPERATOR_KEYS": "anthropic=ANTHROPIC_API_KEY",
    "TRACEAUDIT_ALLOW_CLIENTS": "sim,anthropic",
    "TRACEAUDIT_ANONYMOUS": "all",
    "TRACEAUDIT_MAX_CALLS_PER_JOB": "200",
    "TRACEAUDIT_MAX_CALLS_PER_DAY": "2000"
  }
}
